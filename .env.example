# ==============================================================================
# WhiteboardOS — Gnani AI Voice Studio Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Gemini Multimodal Vision & Generation API
# Obtain at: https://aistudio.google.com/app/apikey
# Supports comma-separated keys for automatic cascade rotation:
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
# Optional backup keys for high-volume failover rotation:
# GEMINI_API_KEY_2=your_backup_gemini_key_2
# GEMINI_API_KEY_3=your_backup_gemini_key_3

# ------------------------------------------------------------------------------
# Gnani AI (Vachana) Speech-to-Text & Text-to-Speech API
# Platform: https://api.vachana.ai (The Great Indian Internship Challenge)
# Header authentication: X-API-Key-ID
# ------------------------------------------------------------------------------
GNANI_API_KEY=your_gnani_api_key_here
